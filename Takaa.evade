local function CreateToggle(parent, text, flag)
    local f = Instance.new("Frame")
    f.Size = UDim2.new(1, -4, 0, 21)
    f.BackgroundColor3 = Color3.fromRGB(22, 22, 28)
    f.Parent = parent
    Instance.new("UICorner", f).CornerRadius = UDim.new(0, 3)

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -35, 1, 0)
    lbl.Position = UDim2.new(0, 5, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = text
    lbl.TextColor3 = Color3.fromRGB(220, 220, 230)
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 8
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = f

    local sw = Instance.new("Frame")
    sw.Size = UDim2.new(0, 22, 0, 12)
    sw.Position = UDim2.new(1, -25, 0.5, -6)
    sw.BackgroundColor3 = getgenv()[flag] and Color3.fromRGB(0, 200, 100) or Color3.fromRGB(55, 55, 65)
    sw.Parent = f
    Instance.new("UICorner", sw).CornerRadius = UDim.new(1, 0)

    local dot = Instance.new("Frame")
    dot.Size = UDim2.new(0, 8, 0, 8)
    dot.Position = getgenv()[flag] and UDim2.new(1, -10, 0.5, -4) or UDim2.new(0, 2, 0.5, -4)
    dot.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    dot.Parent = sw
    Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)

    local click = Instance.new("TextButton")
    click.Size = UDim2.new(1, 0, 1, 0)
    click.BackgroundTransparency = 1
    click.Text = ""
    click.Parent = f

    click.Activated:Connect(function()
        PlayClickSound()
        getgenv()[flag] = not getgenv()[flag]
        sw.BackgroundColor3 = getgenv()[flag] and Color3.fromRGB(0, 200, 100) or Color3.fromRGB(55, 55, 65)
        dot.Position = getgenv()[flag] and UDim2.new(1, -10, 0.5, -4) or UDim2.new(0, 2, 0.5, -4)
        
        if getgenv()[flag] then
            SendNotification("TAKAA HUB", text .. " Enabled ✅")
        else
            SendNotification("TAKAA HUB", text .. " Disabled ❌")
        end
    end)
end

